<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ストップウォッチ ランキング</title>
<link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@500;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#fff4d6; --ink:#1b1f4b; --panel:#ffffff; --blue:#2ec4ff; --red:#ff4d6d; --green:#1fc98a; --yellow:#ffd23f;
  --gold:#ffd23f; --silver:#d5dbe6; --bronze:#f0a56a; --line:#1b1f4b;
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#14173a;--ink:#fff;--panel:#232866;--line:#000;}}
:root[data-theme="dark"]{--bg:#14173a;--ink:#fff;--panel:#232866;--line:#000;}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
body{margin:0;min-height:100%;background:var(--bg);color:var(--ink);font-family:"M PLUS Rounded 1c","Hiragino Maru Gothic ProN","Yu Gothic",sans-serif;font-weight:800;
  background-image:radial-gradient(circle at 12px 12px,rgba(46,196,255,.25) 3px,transparent 4px);background-size:36px 36px}
.app{display:grid;grid-template-columns:1.15fr 1fr;gap:20px;padding:20px;height:100vh;height:100dvh;max-width:1600px;margin:0 auto}
.card{background:var(--panel);border:5px solid var(--line);border-radius:28px;box-shadow:0 8px 0 var(--line);padding:22px;display:flex;flex-direction:column;min-height:0}
h1,h2{margin:0;font-weight:900}
h2{font-size:clamp(22px,2.4vw,32px)}
/* timer */
.timer-wrap{flex:1;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:10px;min-height:0}
.timer{font-variant-numeric:tabular-nums;font-feature-settings:"tnum";font-weight:900;font-size:clamp(90px,18vw,320px);line-height:1;letter-spacing:-.02em;
  background:#1b1f4b;color:#fff;border-radius:24px;padding:.15em .25em;width:100%;text-align:center;border:5px solid var(--line);box-shadow:inset 0 -8px 0 rgba(0,0,0,.25)}
.timer.running{color:#7dffc8}
.status{font-size:clamp(16px,1.8vw,24px);opacity:.8;min-height:1.4em}
.btns{display:grid;grid-template-columns:1.4fr 1.4fr 1fr;gap:14px;margin-top:10px}
button{font:inherit;font-weight:900;cursor:pointer;border:5px solid var(--line);border-radius:22px;color:#fff;min-height:96px;font-size:clamp(22px,2.6vw,38px);
  box-shadow:0 8px 0 var(--line);transition:transform .08s,box-shadow .08s;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
button:active:not(:disabled){transform:translateY(6px);box-shadow:0 2px 0 var(--line)}
button:disabled{opacity:.35;cursor:not-allowed}
button:focus-visible{outline:4px solid var(--blue);outline-offset:3px}
.start{background:var(--green)} .stop{background:var(--red)} .reset{background:var(--blue);color:#0b2a3a}
/* ranking */
.rank-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px}
.small{min-height:52px;font-size:18px;padding:0 16px;border-radius:16px;border-width:4px;box-shadow:0 5px 0 var(--line);background:#fff;color:#1b1f4b}
.small.danger{background:var(--red);color:#fff}
.list{list-style:none;margin:0;padding:0 4px 8px 0;overflow-y:auto;flex:1;display:flex;flex-direction:column;gap:10px}
.row{display:grid;grid-template-columns:64px auto 1fr 52px;grid-template-areas:'no tm nm del' 'no sub sub del';align-items:center;column-gap:12px;row-gap:2px;padding:10px 12px;border:4px solid var(--line);border-radius:18px;background:var(--panel);font-size:clamp(16px,1.6vw,22px)}
.row .no{grid-area:no;font-size:1.5em;text-align:center;font-weight:900}
.row .tm{grid-area:tm;font-size:1.5em;font-variant-numeric:tabular-nums;font-weight:900}
.row .nm{grid-area:nm;min-width:0;font-size:1.15em;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.row .sub{grid-area:sub;font-size:.7em;opacity:.8;font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.row .del{grid-area:del;min-height:44px;width:44px;padding:0;font-size:22px;border-width:3px;border-radius:14px;box-shadow:0 4px 0 var(--line);background:#fff;color:var(--red)}
.row.r1{background:linear-gradient(135deg,#ffe36e,#ffc400);color:#3a2a00;font-size:clamp(18px,2vw,28px);padding:16px 12px;box-shadow:0 0 0 4px #fff7b8,0 0 22px #ffc400}
.row.r1 .no{font-size:2.2em}.row.r1 .tm{font-size:1.9em}
.row.r2{background:linear-gradient(135deg,#eef1f7,#c3cad8);color:#1f2633}
.row.r3{background:linear-gradient(135deg,#ffcfa3,#e8914f);color:#3b1e08}
.row.new{animation:pop .7s ease}
@keyframes pop{0%{transform:scale(.8);opacity:0}60%{transform:scale(1.04)}100%{transform:scale(1);opacity:1}}
.empty{margin:auto;text-align:center;font-size:22px;opacity:.7;line-height:1.8}
/* modal */
.overlay{position:fixed;inset:0;background:rgba(10,12,40,.65);display:none;align-items:center;justify-content:center;padding:20px;z-index:20}
.overlay.show{display:flex}
.modal{background:var(--panel);color:var(--ink);border:6px solid var(--line);border-radius:30px;box-shadow:0 10px 0 var(--line);padding:28px;width:min(560px,100%);max-height:100%;overflow:auto;animation:pop .35s ease}
.modal h2{text-align:center;margin-bottom:6px}
.big-time{text-align:center;font-size:clamp(44px,8vw,80px);font-weight:900;font-variant-numeric:tabular-nums;margin:6px 0 14px}
label{display:block;font-size:18px;margin:12px 0 6px}
input{width:100%;font:inherit;font-weight:800;font-size:24px;padding:14px 16px;border:4px solid var(--line);border-radius:16px;background:#fff;color:#1b1f4b}
input:focus{outline:4px solid var(--blue)}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
.chip{min-height:44px;font-size:16px;padding:0 14px;border-width:3px;border-radius:999px;box-shadow:0 3px 0 var(--line);background:#fff;color:#1b1f4b}
.m-btns{display:grid;grid-template-columns:1fr 1.5fr;gap:12px;margin-top:20px}
.m-btns button{min-height:76px;font-size:26px}
.cele{text-align:center}
.cele .emoji{font-size:90px;line-height:1;animation:bounce 1s infinite}
@keyframes bounce{50%{transform:translateY(-14px) rotate(-6deg)}}
.cele h2{font-size:clamp(30px,5vw,46px);color:var(--red)}
.cele p{font-size:22px;margin:6px 0}
#confetti{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:30}
@media (max-width:900px){
  .app{grid-template-columns:1fr;height:auto}
  .card{min-height:auto}
  .list{max-height:60vh}
  .row{grid-template-columns:48px auto 1fr 44px}
}
@media (prefers-reduced-motion:reduce){.row.new,.modal,.cele .emoji{animation:none}}
</style>
</head>
<body>
<main class="app">
  <section class="card" aria-label="ストップウォッチ">
    <h1 style="font-size:clamp(22px,2.4vw,32px)">⏱️ ストップウォッチ</h1>
    <div class="timer-wrap">
      <div class="timer" id="timer" role="timer" aria-live="off">00:00</div>
      <div class="status" id="status">スタートをおして はかろう！（スペースキーでもOK）</div>
    </div>
    <div class="btns">
      <button class="start" id="btnStart">▶ スタート</button>
      <button class="stop" id="btnStop" disabled>■ ストップ</button>
      <button class="reset" id="btnReset" disabled>↺ リセット</button>
    </div>
  </section>

  <section class="card" aria-label="ランキング">
    <div class="rank-head">
      <h2>🏆 ランキング</h2>
      <button class="small danger" id="btnClear">ぜんぶ消す</button>
    </div>
    <ol class="list" id="list"></ol>
  </section>
</main>

<!-- お祝い -->
<div class="overlay" id="celeOverlay">
  <div class="modal cele" role="dialog" aria-modal="true">
    <div class="emoji" id="celeEmoji">🎉</div>
    <h2>新記録達成！おめでとう！</h2>
    <p id="celeText"></p>
    <div class="big-time" id="celeTime"></div>
    <div class="m-btns" style="grid-template-columns:1fr"><button class="start" id="celeNext">記録を保存する</button></div>
  </div>
</div>

<!-- 保存 -->
<div class="overlay" id="saveOverlay">
  <div class="modal" role="dialog" aria-modal="true">
    <h2>この記録を保存</h2>
    <div class="big-time" id="saveTime"></div>
    <label for="inName">名前（なくてもOK）</label>
    <input id="inName" maxlength="12" autocomplete="off" placeholder="れい：たろう">
    <label for="inMemo">メモ（なくてもOK）</label>
    <input id="inMemo" maxlength="20" autocomplete="off" placeholder="れい：50m走 1回目">
    <div class="chips" id="chips"></div>
    <div class="m-btns">
      <button class="reset" id="btnSkip">保存しない</button>
      <button class="start" id="btnSave">💾 保存する</button>
    </div>
  </div>
</div>

<!-- 確認 -->
<div class="overlay" id="confirmOverlay">
  <div class="modal">
    <h2 id="confirmText">ほんとうに消す？</h2>
    <div class="m-btns">
      <button class="reset" id="confirmNo">やめる</button>
      <button class="stop" id="confirmYes">消す</button>
    </div>
  </div>
</div>

<canvas id="confetti"></canvas>

<script>
(function(){
  const KEY='stopwatch-ranking-v1';
  const $=id=>document.getElementById(id);
  const timerEl=$('timer'), statusEl=$('status');
  const bStart=$('btnStart'), bStop=$('btnStop'), bReset=$('btnReset');
  let state='idle', t0=0, elapsed=0, raf=0, pending=null, newId=null, records=[];

  try{ records=JSON.parse(localStorage.getItem(KEY)||'[]'); if(!Array.isArray(records)) records=[]; }catch(e){ records=[]; }
  const persist=()=>{ try{ localStorage.setItem(KEY,JSON.stringify(records)); }catch(e){} };

  const fmt=ms=>{
    const s=Math.floor(ms/1000)%60, m=Math.floor(ms/60000);
    return {main:String(m).padStart(2,'0')+':'+String(s).padStart(2,'0')};
  };
  const fmtText=ms=>{const f=fmt(ms);return f.main;};
  const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

  function draw(){ timerEl.textContent=fmt(elapsed).main; }
  function loop(){ elapsed=performance.now()-t0; draw(); raf=requestAnimationFrame(loop); }

  function setUI(){
    bStart.disabled = state==='running';
    bStop.disabled = state!=='running';
    bReset.disabled = state==='running' || elapsed===0;
    timerEl.classList.toggle('running',state==='running');
    bStart.textContent = state==='stopped' ? '▶ つづける' : '▶ スタート';
    statusEl.textContent = state==='running' ? 'けいそく中…！' : state==='stopped' ? 'ストップ！ もう一度はかるときはリセット' : 'スタートをおして はかろう！（スペースキーでもOK）';
  }

  function start(){ if(state==='running') return; t0=performance.now()-elapsed; state='running'; cancelAnimationFrame(raf); raf=requestAnimationFrame(loop); setUI(); }
  function stop(){
    if(state!=='running') return;
    cancelAnimationFrame(raf); elapsed=performance.now()-t0; draw(); state='stopped'; setUI();
    if(Math.floor(elapsed/10)===0) return;
    const ms=Math.floor(elapsed/10)*10; // 1/100秒単位で記録
    const d=new Date(); const date=(d.getMonth()+1)+'/'+d.getDate();
    pending={ms,date};
    const rank=records.filter(r=>r.ms<ms).length+1;
    if(rank<=3){
      $('celeEmoji').textContent = rank===1?'👑':'🏅';
      $('celeText').textContent = rank===1 ? 'ぜんぶの記録で いちばん はやい！ 1位！' : rank+'位にランクイン！';
      $('celeTime').textContent = fmtText(ms);
      $('celeOverlay').classList.add('show');
      burst();
    }else openSave();
  }
  function reset(){ if(state==='running') return; cancelAnimationFrame(raf); elapsed=0; state='idle'; draw(); setUI(); }

  function openSave(){
    $('saveTime').textContent=fmtText(pending.ms);
    $('saveOverlay').classList.add('show');
    setTimeout(()=>$('inName').focus(),50);
  }
  function closeSave(){ $('saveOverlay').classList.remove('show'); pending=null; }
  function save(){
    if(!pending) return;
    const rec={id:Date.now()+''+Math.floor(Math.random()*1000),ms:pending.ms,name:$('inName').value.trim(),memo:$('inMemo').value.trim(),date:pending.date};
    records.push(rec); persist(); newId=rec.id;
    closeSave(); $('inName').value='';
    render();
  }

  function render(){
    const sorted=records.slice().sort((a,b)=>a.ms-b.ms||a.id.localeCompare(b.id));
    const list=$('list');
    if(!sorted.length){ list.innerHTML='<li class="empty">まだ記録がありません<br>はかって ランキングに のろう！</li>'; return; }
    list.innerHTML=sorted.map((r,i)=>{
      const n=i+1;
      const mark = n===1?'👑':n===2?'🥈':n===3?'🥉':n;
      return '<li class="row'+(n<=3?' r'+n:'')+(r.id===newId?' new':'')+'">'+
        '<div class="no">'+mark+'</div>'+
        '<div class="tm">'+fmtText(r.ms)+'</div>'+
        '<div class="nm">'+(r.name?esc(r.name):'（なまえなし）')+'</div>'+
        '<div class="sub">'+esc(r.date)+(r.memo?' | '+esc(r.memo):'')+'</div>'+
        '<button class="del" data-id="'+r.id+'" aria-label="この記録を削除">×</button></li>';
    }).join('');
    newId=null;
  }

  // 確認ダイアログ
  let onYes=null;
  function ask(text,fn){ $('confirmText').textContent=text; onYes=fn; $('confirmOverlay').classList.add('show'); }
  $('confirmNo').onclick=()=>{ $('confirmOverlay').classList.remove('show'); onYes=null; };
  $('confirmYes').onclick=()=>{ $('confirmOverlay').classList.remove('show'); if(onYes) onYes(); onYes=null; };

  $('list').addEventListener('click',e=>{
    const b=e.target.closest('.del'); if(!b) return;
    const id=b.dataset.id;
    ask('この記録を消す？',()=>{ records=records.filter(r=>r.id!==id); persist(); render(); });
  });
  $('btnClear').onclick=()=>{ if(!records.length) return; ask('ランキングをぜんぶ消す？',()=>{ records=[]; persist(); render(); }); };

  // メモ候補
  ['50m走','100m走','1回目','2回目','3回目'].forEach(t=>{
    const c=document.createElement('button'); c.type='button'; c.className='chip'; c.textContent=t;
    c.onclick=()=>{ $('inMemo').value=t; };
    $('chips').appendChild(c);
  });

  bStart.onclick=start; bStop.onclick=stop; bReset.onclick=reset;
  $('celeNext').onclick=()=>{ $('celeOverlay').classList.remove('show'); openSave(); };
  $('btnSave').onclick=save; $('btnSkip').onclick=closeSave;
  ['inName','inMemo'].forEach(id=>$(id).addEventListener('keydown',e=>{ if(e.key==='Enter') save(); }));
  document.addEventListener('keydown',e=>{
    if(e.code!=='Space'||document.querySelector('.overlay.show')) return;
    if(e.target.tagName==='BUTTON') return;
    e.preventDefault(); state==='running' ? stop() : (state==='idle' ? start() : null);
  });

  // 紙ふぶき
  const cv=$('confetti'), ctx=cv.getContext('2d'); let parts=[], cRaf=0;
  function size(){ cv.width=innerWidth*devicePixelRatio; cv.height=innerHeight*devicePixelRatio; }
  addEventListener('resize',size); size();
  function burst(){
    const colors=['#ff4d6d','#ffd23f','#2ec4ff','#1fc98a','#ff8fab','#9b5de5','#ffffff'];
    const W=cv.width,H=cv.height,dpr=devicePixelRatio;
    for(let i=0;i<260;i++){
      const fromSide=i%3, x= fromSide===0? Math.random()*W : fromSide===1? 0 : W;
      const y= fromSide===0? -20*dpr : H*0.6;
      const ang= fromSide===0? Math.PI/2+(Math.random()-.5)*1.2 : (fromSide===1? -Math.PI/4 : -3*Math.PI/4)+(Math.random()-.5)*.8;
      const sp=(fromSide===0? 4+Math.random()*6 : 16+Math.random()*16)*dpr;
      parts.push({x,y,vx:Math.cos(ang)*sp,vy:Math.sin(ang)*sp,w:(8+Math.random()*10)*dpr,h:(5+Math.random()*7)*dpr,
        r:Math.random()*6,vr:(Math.random()-.5)*.4,c:colors[i%colors.length],life:0,max:200+Math.random()*100,round:Math.random()<.25});
    }
    cancelAnimationFrame(cRaf); tick();
  }
  function tick(){
    ctx.clearRect(0,0,cv.width,cv.height);
    const g=.35*devicePixelRatio;
    parts=parts.filter(p=>p.life<p.max && p.y<cv.height+40);
    parts.forEach(p=>{
      p.vx*=.985; p.vy=p.vy*.985+g*.5; p.x+=p.vx; p.y+=p.vy; p.r+=p.vr; p.life++;
      ctx.save(); ctx.translate(p.x,p.y); ctx.rotate(p.r); ctx.scale(1,Math.cos(p.r*2));
      ctx.globalAlpha=Math.min(1,(p.max-p.life)/40); ctx.fillStyle=p.c;
      if(p.round){ ctx.beginPath(); ctx.arc(0,0,p.h/1.2,0,7); ctx.fill(); } else ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h);
      ctx.restore();
    });
    if(parts.length) cRaf=requestAnimationFrame(tick); else ctx.clearRect(0,0,cv.width,cv.height);
  }

  render(); draw(); setUI();
})();
</script>
</body>
</html>
